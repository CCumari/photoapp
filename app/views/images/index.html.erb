<% content_for :title, "My Photos" %>

<div class="page-header fade-in-up">
  <div class="d-flex justify-content-between align-items-center">
    <div>
      <h1><i class="fas fa-images me-3"></i>My Photos</h1>
      <p class="subtitle">Manage and view all your uploaded photos</p>
    </div>
    <%= link_to new_image_path, class: "btn-rails" do %>
      <i class="fas fa-plus"></i>
      Upload New Photo
    <% end %>
  </div>
</div>

<% if @images.any? %>
  <div class="photo-grid">
    <% @images.each_with_index do |image, index| %>
      <div class="photo-card fade-in-up" style="animation-delay: <%= index * 0.1 %>s;">
        <% if image.picture.present? %>
          <%= image_tag image.picture.thumb.url, 
              class: "card-img-top", 
              alt: image.name,
              loading: "lazy",
              style: "height: 250px; object-fit: cover;" %>
        <% else %>
          <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 250px;">
            <i class="fas fa-image text-muted" style="font-size: 3rem;"></i>
          </div>
        <% end %>
        
        <div class="card-body">
          <h5 class="card-title text-truncate"><%= image.name.presence || "Untitled Photo" %></h5>
          <p class="card-text">
            <small class="text-muted">
              <i class="fas fa-calendar me-1"></i>
              Uploaded <%= time_ago_in_words(image.created_at) %> ago
            </small>
          </p>
          
          <div class="d-flex gap-2">
            <%= link_to image_path(image), class: "btn btn-sm btn-rails-outline flex-fill" do %>
              <i class="fas fa-eye"></i>
              View
            <% end %>
            <%= link_to edit_image_path(image), class: "btn btn-sm btn-outline-secondary" do %>
              <i class="fas fa-edit"></i>
            <% end %>
            <%= button_to image_path(image), method: :delete, 
                         confirm: "Are you sure you want to delete this photo?", 
                         class: "btn btn-sm btn-outline-danger",
                         form: { style: "display: inline;" } do %>
              <i class="fas fa-trash"></i>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-4 text-center">
    <p class="text-muted">
      <i class="fas fa-info-circle me-1"></i>
      You have <%= pluralize(@images.count, 'photo') %> in your collection
    </p>
  </div>
<% else %>
  <div class="empty-state fade-in-up">
    <div class="empty-icon">
      <i class="fas fa-camera"></i>
    </div>
    <h3>No photos yet</h3>
    <p>Start building your photo collection by uploading your first image.</p>
    <%= link_to new_image_path, class: "btn-rails" do %>
      <i class="fas fa-plus"></i>
      Upload Your First Photo
    <% end %>
  </div>
<% end %>

<% content_for :title, "Edit Photo" %>

<div class="page-header fade-in-up">
  <h1><i class="fas fa-edit me-3"></i>Edit Photo</h1>
  <p class="subtitle">Update your photo details and image</p>
</div>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="photo-card fade-in-up">
      <div class="card-body p-4">
        <%= render "form", image: @image %>
      </div>
      <div class="card-footer bg-light">
        <div class="d-flex justify-content-between align-items-center">
          <div class="btn-group" role="group">
            <%= link_to image_path(@image), class: "btn btn-outline-secondary" do %>
              <i class="fas fa-eye me-2"></i>
              View Photo
            <% end %>
            <%= link_to images_path, class: "btn btn-outline-secondary" do %>
              <i class="fas fa-arrow-left me-2"></i>
              Back to Photos
            <% end %>
          </div>
          <small class="text-muted">
            <i class="fas fa-clock me-1"></i>
            Last updated <%= time_ago_in_words(@image.updated_at) %> ago
          </small>
        </div>
      </div>
    </div>
  </div>
</div>

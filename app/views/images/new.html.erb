<% content_for :title, "Upload New Photo" %>

<div class="page-header fade-in-up">
  <h1><i class="fas fa-cloud-upload-alt me-3"></i>Upload New Photo</h1>
  <p class="subtitle">Share your moments with the world</p>
</div>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="photo-card fade-in-up">
      <div class="card-body p-4">
        <%= render "form", image: @image %>
      </div>
      <div class="card-footer bg-light">
        <div class="d-flex justify-content-between align-items-center">
          <%= link_to images_path, class: "btn btn-outline-secondary" do %>
            <i class="fas fa-arrow-left me-2"></i>
            Back to Photos
          <% end %>
          <small class="text-muted">
            <i class="fas fa-info-circle me-1"></i>
            Supported formats: JPG, PNG, GIF (Max 10MB)
          </small>
        </div>
      </div>
    </div>
  </div>
</div>

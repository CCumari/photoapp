<% content_for :title, @image.name.presence || "Photo Details" %>

<div class="row justify-content-center fade-in-up">
  <div class="col-lg-10">
    <!-- Back Navigation -->
    <div class="mb-3">
      <%= link_to images_path, class: "btn btn-outline-secondary" do %>
        <i class="fas fa-arrow-left me-2"></i>
        Back to My Photos
      <% end %>
    </div>

    <!-- Image Display -->
    <div class="image-detail">
      <% if @image.picture.present? %>
        <%= image_tag @image.picture.large.url, 
            alt: @image.name, 
            class: "img-fluid",
            style: "width: 100%; max-height: 70vh; object-fit: contain; background: #f8f9fa;" %>
      <% else %>
        <div class="text-center p-5 bg-light">
          <i class="fas fa-image text-muted" style="font-size: 5rem;"></i>
          <p class="text-muted mt-3">No image available</p>
        </div>
      <% end %>
      
      <!-- Image Metadata -->
      <div class="image-meta">
        <div class="row">
          <div class="col-md-8">
            <h2 class="mb-3">
              <i class="fas fa-image me-2 text-muted"></i>
              <%= @image.name.presence || "Untitled Photo" %>
            </h2>
            
            <div class="d-flex flex-wrap gap-3 text-muted mb-3">
              <span>
                <i class="fas fa-calendar me-1"></i>
                Uploaded <%= @image.created_at.strftime("%B %d, %Y at %I:%M %p") %>
              </span>
              <span>
                <i class="fas fa-user me-1"></i>
                by <%= @image.user.email %>
              </span>
              <% if @image.updated_at != @image.created_at %>
                <span>
                  <i class="fas fa-edit me-1"></i>
                  Last updated <%= time_ago_in_words(@image.updated_at) %> ago
                </span>
              <% end %>
            </div>
          </div>
          
          <div class="col-md-4 text-md-end">
            <div class="btn-group" role="group">
              <%= link_to edit_image_path(@image), class: "btn btn-rails-outline" do %>
                <i class="fas fa-edit me-1"></i>
                Edit
              <% end %>
              
              <%= button_to image_path(@image), 
                           method: :delete,
                           confirm: "Are you sure you want to delete this photo? This action cannot be undone.",
                           class: "btn btn-outline-danger" do %>
                <i class="fas fa-trash me-1"></i>
                Delete
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
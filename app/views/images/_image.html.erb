<div id="<%= dom_id image %>" class="card-text">
  <% if image.picture.present? %>
    <div class="mb-3">
      <%= image_tag image.picture.thumb.url, 
          class: "img-fluid rounded", 
          alt: image.name,
          loading: "lazy" %>
    </div>
  <% else %>
    <div class="mb-3 bg-light rounded d-flex align-items-center justify-content-center" style="height: 200px;">
      <i class="fas fa-image text-muted" style="font-size: 3rem;"></i>
    </div>
  <% end %>
  
  <h5 class="card-title text-truncate"><%= image.name.presence || "Untitled Photo" %></h5>
  
  <% if image.user %>
    <p class="card-text">
      <small class="text-muted">
        <i class="fas fa-user me-1"></i>
        <%= image.user.email %>
      </small>
    </p>
  <% end %>
</div>
